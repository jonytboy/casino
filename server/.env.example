# Copy to .env and fill in. Nothing here has a safe default except the port.

PORT=8080

# Where the SQLite file lives. This is the balances — back it up, and mount it
# on a volume in any container deployment.
DB_PATH=./data/casino.db

# Economy
STARTING_COINS=10000
FREE_COINS=2000
FREE_COOLDOWN_MS=900000

# Whop webhook signing secret. Until this is set the webhook refuses every
# request with 503, so purchases cannot be credited by an unsigned caller.
WHOP_WEBHOOK_SECRET=

# The origin the browser game is served from. "*" is fine while testing and
# wrong in production — set it to your real origin.
ALLOW_ORIGIN=*
