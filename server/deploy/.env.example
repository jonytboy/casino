# Copy to .env on the server. This file holds the webhook secret, so it stays
# out of git — see .gitignore.

# The hostname you pointed at this box. Caddy gets a certificate for it, so the
# DNS A record must already resolve here before the first `docker compose up`.
#
# No domain yet? You do not need one to go live. sslip.io resolves any IP baked
# into the hostname, so with the box at 203.0.113.7 this works today and gets a
# real certificate:
#
#   DOMAIN=203-0-113-7.sslip.io
#   ALLOW_ORIGIN=https://203-0-113-7.sslip.io
#
# Swap both lines for the real name when you have one; nothing else changes.
DOMAIN=casinocarib.com

# The page is served from this same origin, so nothing legitimate is
# cross-origin. Must match DOMAIN.
ALLOW_ORIGIN=https://casinocarib.com

# Economy
STARTING_COINS=10000
FREE_COINS=2000
FREE_COOLDOWN_MS=900000

# Whop webhook signing secret. Until this is set the webhook refuses every
# request with 503, so purchases cannot be credited by an unsigned caller.
WHOP_WEBHOOK_SECRET=
